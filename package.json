{
  "name": "protolive",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "dev": "pnpm --filter @protolive/web dev",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "proto:lint": "buf lint",
    "proto:generate": "pnpm --filter @protolive/protocol-ts generate",
    "proto:breaking": "buf breaking --against '.git#branch=origin/main'"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.74.0"
  }
}
